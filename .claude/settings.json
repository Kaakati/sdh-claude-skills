{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      "vendor/bundle"
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.credentials/**)",
      "Read(**/*secret*)",
      "Read(**/master.key)",
      "Read(**/credentials.yml.enc)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/*.generated.*)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/vendor/**)",
      "Read(**/public/assets/**)",
      "Read(**/public/packs/**)",
      "Read(**/tmp/cache/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf /)*",
      "Bash(rm -rf /*)",
      "Bash(chmod 777:*)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(terraform destroy:*)",
      "Bash(tofu destroy:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform state push:*)",
      "Bash(terraform force-unlock:*)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(rails db:migrate:status)",
      "Bash(rails routes:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx react-native:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate)",
      "Bash(terraform fmt:*)",
      "Bash(terraform init:*)",
      "Bash(terraform output:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",
      "Bash(terraform providers:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npx vite:*)",
      "Bash(npx next:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)"
    ]
  }
}
