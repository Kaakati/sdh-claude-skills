{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/.credentials/**)",
      "Read(**/*secret*)",
      "Read(**/master.key)",
      "Read(**/credentials.yml.enc)",
      "Bash(sudo:*)",
      "Bash(rm -rf /)*",
      "Bash(rm -rf /*)",
      "Bash(chmod 777:*)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(rails db:migrate:status)",
      "Bash(rails routes:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx react-native:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate)",
      "Bash(terraform fmt:*)",
      "Bash(terraform init:*)",
      "Bash(terraform output:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",
      "Bash(terraform providers:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npx vite:*)",
      "Bash(npx next:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/security-scan.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/migration-validator.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/dangerous-command-blocker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/pre-commit-check.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/deployment-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/auto-format.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/test-runner.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/code-quality-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/error-handling-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/test-coverage-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/clean-architecture-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/i18n-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/accessibility-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/api-design-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/monitoring-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/atomic-design-checker.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/terraform-checker.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/audit-logger.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/session-start-check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/vague-request-detector.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/session-stop-summary.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/subagent-context.py",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/teammate-idle-checker.py",
            "timeout": 15
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/task-completed-checker.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/run-python.sh .claude/hooks/team-task-validator.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
